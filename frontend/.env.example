# Leave both empty (the default) to go through Vite's dev proxy — see
# vite.config.ts. Requests then land same-origin, so the session cookie
# just works with no CORS configuration on the backend.
#
# Set VITE_API_URL to an absolute origin (e.g. http://localhost:8080) to
# bypass the proxy — the backend would then need CORS + credentialed-cookie
# support for that origin. Set VITE_WS_URL similarly (e.g. ws://localhost:8080/ws);
# left empty, it's derived from the page's own origin.
VITE_API_URL=
VITE_WS_URL=

# Optional TURN server for WebRTC calls, on top of the public STUN server
# used by default (see src/calls/peerConnection.ts). Needed for calls to
# work across symmetric NATs / locked-down corporate networks that STUN
# alone can't traverse. `docker compose --profile turn up -d` starts a local
# coturn instance matching these defaults (it's opt-in, not started by plain
# `docker compose up` / `./dev.sh`); point at a hosted TURN provider in production.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
